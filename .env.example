# Google Gemini API Key
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default Model (gemini-1.5-flash-8b, gemini-1.5-flash, gemini-2.0-flash)
DEFAULT_GEMINI_MODEL=gemini-1.5-flash-8b

# Optional: Laya Decision Model checkpoint (english, multilingual, typed-decisions)
LAYA_MODEL=english
